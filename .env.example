# Lifeline environment configuration (copy to .env)

# Node identity and storage
LIFELINE_NODE_ID=edge_device_alpha
# LIFELINE_DATA_DIR=./data                 # defaults to <repo>/data
# LIFELINE_RUNTIME_DIR=./data/runtime      # profile, incidents, sync log, media
# QDRANT_STORAGE_PATH=./data/edge_shards   # Qdrant Edge shards
# FASTEMBED_CACHE_PATH=./data/models       # embedding model (kept for offline use)
QDRANT_MEMORY_MODE=false                   # true = ephemeral shards (tests)

# Security - set both before exposing the API beyond localhost
# LIFELINE_API_KEY=change-me               # required as X-API-Key on every /api call
# LIFELINE_ADMIN_KEY=change-me-too         # required as X-Admin-Key to publish trusted protocols
LIFELINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
LIFELINE_MAX_UPLOAD_MB=15

# Upstream hub (another Lifeline API) for edge-to-server sync
# LIFELINE_SERVER_URL=https://hub.example.org
# LIFELINE_SERVER_API_KEY=hub-api-key

# Optional local LLM: may only add a one-line summary, never the steps
LIFELINE_ENABLE_LLM_SUMMARY=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Optional Cloudinary media upload when online
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

HOST=127.0.0.1
PORT=8000
